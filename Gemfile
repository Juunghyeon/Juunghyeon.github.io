source "https://rubygems.org"
gemspec

# Windows does not ship the time-zone database used by Jekyll.
gem "tzinfo", "~> 2.0", platforms: [:mingw, :x64_mingw, :mswin]
gem "tzinfo-data", platforms: [:mingw, :x64_mingw, :mswin]
# Ruby 3 no longer includes the development web server in its standard library.
gem "webrick", "~> 1.8"
