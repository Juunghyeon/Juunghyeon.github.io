# S21z10 common controller env (= HWL1_config_S21z7 env without DEPLOY_* / RA_EST_DELAY, + S21z8 grace 1.5 / unrec load 15, + S21z10 FS_U0)
# usage: source sim2real/config/s21z15/common.env   (then deploy_real.py as in README.md)
export RA_ARB_FREL_VIOL=0
export RA_ARB_FREL_VIOL_N=2
export RA_D_POSTURE=200
export RA2E_ENT_RAW=25
export RA_TRK_SW_Z1=1
export RA_IMU_OFF=0,1.4
export RA_D_REL_FAST=0.02,8
export RA_IMU_WAIST_K=c20
export RA2E_KIN_REL=1.5,0.1
export RA2E_REFRACT=1,4,0.7
export RA_VEL_NOTCH_J=12,13,14
export RA_VEL_NOTCH_HOLD=1
export RA_KD_SCALE=0:1.5,6:1.5,1:4,7:4,2:1.5,8:1.5,3:2,9:2,4:10,10:10,5:20,11:20
export RA_TAU_LP=1
export RA_TAU_LP_MODE=ns
export RA_REC_DZ=0.04,0.4,0,3
export RA_HOLD_ZPD=50,15,1,1,0.02
export RA2E_MOT_K=25,0.05,0.5,70
export RA_IMU_DRATE=10000
export RA_HOLD_LEGPD=0.15
export RA_TRK_SW_KP=0.5
export RA_TRK_SW_KD=0.5
export RA_VEL_CF=2
export RA_TRK_FOOT=0.1
export RA_V_LP=15
export RA_PLAN_XF=0.04
export RA_PLAN_XF_QUIET=3   # S21z12: replans cross-faded also in hold-first (MPC cdd target jumped 1-2.5 m/s2 per replan)
export RA_PLAN_XF_LIN=1
export RA_PLAN_XF_D=1000
export RA_D_TARE=1
export RA_D_TARE_E=15
export RA_D_TARE_T=3
export RA_D_TARE_RATE=1
export RA_HELD_REL=20,0.06
export RA_MPC_QPOS=0.25
export RA_FF_K=0.7
export RA2E_REMOVAL=1
export RA_LAND_COMP=0,0.05,0
export RA_FS_TIMING_LAT=0.12,0.15,0.2,0.25,0.3
export RA_ARB_FCONF=0.95
export RA_FS_TIMING_LAT_FIRST=1.0
export RA_ID_FW=0.1
export RA_ANKLE_CENTROIDAL=1
export RA_TAU_RL=2
export RA_TRK_YREG=1e-2
export RA_TRK_YREG_HOLD=0.1
export RA_TIP_GATE=1.0
export OPENBLAS_NUM_THREADS=1
export RA_NOSTEP_NOREL=1
export RA_POST_TMAX=1.5
export RA_POSTHOLD_GRACE=1.5
export RA_ARB_UNREC_LOAD=15
export RA_FS_U0=0.01,0.005
export RA_ANK_LREG=0.05
