# S21z23 no-step env for the hold (2026-11-19; robot PC development run ns_cs2_dev R2_20261119_135533: 17 lateral 28-83 N held, pitch within
# 4 deg, almost no rocking, no forward drift): nostep.env + lateral-only corner scale + release-rebound monitor. Deploy WITHOUT --steps.
# RA_CORNER_SCALE 1.0,0.7: hold CoP corners at 70 % of the sole laterally (narrow rounded real sole; S21z14), fore-aft unchanged
# (0.75 fore-aft made a 46 N push end in a slow forward fall on hardware; NS3 bench: backward capacity lost on the rigid sim sole).
# RA2E_REBOUND as step.env (the hold ends on the release rebound and the cancellation stops). NS3 bench (rigid flat sim sole, does not show the
# hardware benefit): shoulder-like 20-30 N 15/18 = nostep.env 15/18, pelvis 40-50 N + fore-aft 30 N 6/18 vs 9/18 (lateral 40 N 4/6 vs 6/6).
source "$(dirname "${BASH_SOURCE[0]}")/nostep.env"
export RA_CORNER_SCALE=1.0,0.7 RA2E_REBOUND=0.1,3,1.0,1.0
